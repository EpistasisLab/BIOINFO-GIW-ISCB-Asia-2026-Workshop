    {
      "parameters": {
        "options": {
          "systemMessage": "You are the Literature Scout on a research team studying heart failure after acute myocardial infarction (MI).\n\nTools:\n- search_pubmed: searches PubMed and returns PubMed IDs (PMIDs).\n- fetch_abstracts: given comma-separated PMIDs, returns titles and abstracts.\n\nHow to work:\n1. Turn the request into a short PubMed query, for example: \"Myocardial Infarction\"[MeSH] AND \"Heart Failure\"[MeSH].\n2. Search, then fetch abstracts for the 3-5 most relevant PMIDs. If a search returns nothing, broaden the query and try again.\n3. Summarize each paper in 2-3 sentences: design, population, main finding.\n4. Cite every claim with its PMID. Never cite a PMID you did not retrieve with a tool.\n5. End with one line headed \"What this means for our team\"."
        }
      },
      "type": "@n8n/n8n-nodes-langchain.agent",
      "typeVersion": 3.1,
      "position": [
        -16,
        -32
      ],
      "id": "bdf78511-57a2-4ef8-8efb-7adf28a8b39d",
      "name": "AI Agent"
    },
    {
      "parameters": {
        "toolDescription": "Search PubMed for biomedical articles. Input a PubMed query string and the number of days to look back. Returns a JSON list of PubMed IDs (PMIDs)",
        "url": "https://eutils.ncbi.nlm.nih.gov/entrez/eutils/esearch.fcgi",
        "sendQuery": true,
        "queryParameters": {
          "parameters": [
            {
              "name": "db",
              "value": "pubmed"
            },
            {
              "name": "retmode",
              "value": "json"
            },
            {
              "name": "retmax",
              "value": "10"
            },
            {
              "name": "sort",
              "value": "relevance"
            },
            {
              "name": "datetype",
              "value": "pdat"
            },
            {
              "name": "term",
              "value": "={{ $fromAI('term', 'PubMed query string; MeSH terms allowed', 'string') }} "
            },
            {
              "name": "reldate",
              "value": "={{ $fromAI('days', 'Only include papers published in the last N days', 'number', 365) }}"
