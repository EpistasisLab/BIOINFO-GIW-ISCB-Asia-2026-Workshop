# Settings for the agent notebooks (Module 2 onwards).
#
# 1. Copy this file to a new file named .env in the same folder:   cp .env_example .env
# 2. Choose ONE provider below and fill in only its lines.
# 3. Restart the notebook kernel after you edit .env.
#
# Never share or commit .env. Values already set in your shell take priority over this file.
# How to get keys: see the guides in the Instructions/ folder.

# Which provider to use: anthropic | openai | foundry_claude | foundry_openai
PROVIDER=anthropic

# Model name (on Foundry: your DEPLOYMENT name). Leave empty to use the default for your provider:
#   anthropic -> claude-sonnet-5-5        openai -> gpt-5.6-terra
#   foundry_claude -> claude-sonnet-5-5   foundry_openai -> gpt-5.6-terra
MODEL=

# ---- PROVIDER=anthropic (Claude, direct) ----
ANTHROPIC_API_KEY=

# ---- PROVIDER=openai (OpenAI, direct) ----
OPENAI_API_KEY=

# ---- PROVIDER=foundry_claude (Claude on Microsoft Foundry) ----
ANTHROPIC_FOUNDRY_API_KEY=
# The resource NAME only (for example my-iscb-resource), not the full URL.
ANTHROPIC_FOUNDRY_RESOURCE=

# ---- PROVIDER=foundry_openai (OpenAI models on Microsoft Foundry) ----
AZURE_OPENAI_API_KEY=
AZURE_OPENAI_BASE_URL=https://<your-resource>.openai.azure.com/openai/v1/
